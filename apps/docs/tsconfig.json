{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/components/ui/*": ["../../packages/ui/src/components/*"],
      "@/*": ["./*"],
      "@opaline/ui": ["../../packages/ui/src/index.ts"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".source/**/*.ts"],
  "exclude": ["node_modules"]
}
